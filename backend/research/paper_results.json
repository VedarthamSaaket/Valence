   "kmeans": 0.248,
   "gmm_diag": 0.217,
   "ward": 0.202,
   "gmm_full": 0.185,
   "spectral_excluded": 0.176
  },
  "percentile_method": "Empirical rank of the score in the sorted reference distribution, clamped to 1-99."
 },
 "caveats": [
  "Reference samples are self-selected open online respondents (openpsychometrics.org); percentiles are ranks within that sample, not the general population.",
  "The respondent pool is majority English-speaking with a US/UK skew.",
